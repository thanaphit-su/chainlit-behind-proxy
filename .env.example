# =============================================================================
# Chainlit + LangGraph Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NOTE: .env is gitignored - never commit it!
# =============================================================================

# =============================================================================
# OpenAI Compatible API Configuration (REQUIRED)
# =============================================================================
# Base URL for your OpenAI-compatible API endpoint
# Examples:
#   - OpenAI: https://api.openai.com/v1
#   - Ollama: http://localhost:11434/v1
#   - vLLM: http://localhost:8000/v1
#   - LM Studio: http://localhost:1234/v1
#   - Together AI: https://api.together.xyz/v1
OPENAI_API_BASE_URL=

# API key for authentication
# Leave empty if your endpoint doesn't require authentication (e.g., local Ollama)
OPENAI_API_KEY=

# Model name to use
# Examples:
#   - OpenAI: gpt-3.5-turbo, gpt-4
#   - Ollama: llama2, mistral, codellama
#   - vLLM: your-model-name
#   - Gemini: Gemini 3.6 Flash
OPENAI_MODEL=

# =============================================================================
# Application Configuration
# =============================================================================
# Port to run the application on (default: 8000)
CHAINLIT_PORT=8000

# Host to bind to (default: 0.0.0.0)
# Use 0.0.0.0 to accept connections from any IP
# Use 127.0.0.1 for local-only access
CHAINLIT_HOST=0.0.0.0

# =============================================================================
# Proxy Configuration (OPTIONAL)
# =============================================================================
# Proxy path pattern: /{username}/proxy/{portNumber}
#
# This is used when running behind a reverse proxy that strips paths.
# The system will auto-detect your username if not set.
#
# Examples:
#   - User "john" on port 8000: /john/proxy/8000
#   - User "alice" on port 3000: /alice/proxy/3000
#
# If left empty, the system will auto-detect from your system username:
#   CHAINLIT_PROXY_PATH=
#
# To override auto-detection, set explicitly:
#   CHAINLIT_PROXY_PATH=/yourusername/proxy/8000
#
# =============================================================================
CHAINLIT_PROXY_PATH=

# =============================================================================
# Advanced Configuration (OPTIONAL)
# =============================================================================
# Maximum iterations for the agentic loop (default: 5)
# Prevents infinite loops if the agent keeps calling tools
# AGENT_MAX_ITERATIONS=5

# Temperature for LLM responses (default: 0.7)
# Lower = more deterministic, Higher = more creative
# LLM_TEMPERATURE=0.7

# Enable/disable streaming (default: true)
# Set to false to receive complete responses at once
# ENABLE_STREAMING=true
